{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "files.associations": {
      "*.yaml": "home-assistant",
    },
    "vscode-home-assistant.ignoreCertificates": true,
    "editor.fontFamily": "Menlo",
    "files.watcherExclude": {
      "**/.aarlo/**": true,
      "**/.cloud/**": true,
      "**/.storage/**": true,
      "**/custom_components/**": true,
      "**/tts/**": true,
      "**/www/**": true,
      "**/themes/**": true,
    },
    "files.exclude": {
      "**/.aarlo/**": true,
      "**/.cloud/**": true,
      "**/.storage/**": true,
      "**/custom_components/**": true,
      "**/tts/**": true,
      "**/www/**": true,
      "**/themes/**": true,
    },
  },
}
